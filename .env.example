# =============================================================================
# Scanner Connector API - Variables de Entorno
# =============================================================================
# Copia este archivo como .env y configura los valores según tu entorno.
# =============================================================================

# -----------------------------------------------------------------------------
# SEGURIDAD (OBLIGATORIO en producción)
# -----------------------------------------------------------------------------

# Clave secreta para JWT y sesiones (mínimo 25 caracteres)
# Genera una con: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=tu-clave-secreta-segura-minimo-25-caracteres

# Modo de ejecución: True = desarrollo, False = producción
DEBUG=False

# -----------------------------------------------------------------------------
# SWAGGER (Documentación API - solo desarrollo)
# -----------------------------------------------------------------------------

# Usuario para acceder a /apidocs/ (mínimo 4 caracteres)
SWAGGER_USER=usuario-swagger

# Contraseña para acceder a /apidocs/ (mínimo 8 caracteres)
SWAGGER_PASSWORD=tu-contraseña-segura

# -----------------------------------------------------------------------------
# INTEGRACIÓN CON DJANGO
# -----------------------------------------------------------------------------

# URL base del servidor Django (para CORS)
DJANGO_URL=http://localhost:8000

# JWT compartido con Django para autenticar requests al conector
FLASK_SHARED_SECRET=clave-jwt-compartida-con-django

# Exigir autenticación JWT en /api/scan/* (recomendado True en producción)
FLASK_REQUIRE_AUTH=True

# Issuer esperado en el token emitido por Django
FLASK_JWT_ISSUER=issuer-del-token-jwt-de-django

# -----------------------------------------------------------------------------
# CONFIGURACIÓN DEL ESCÁNER
# -----------------------------------------------------------------------------

# Nombre del driver TWAIN del escáner
# Ejecuta utils/list_scanners.py para ver los disponibles, deja el escaner por defecto que vas a usar
SCANNER_NAME=Type301 Scanner

# Nombre del escáner secundario para fallback automático (opcional)
SCANNER_NAME_SECONDARY=e-STUDIO2822ASeries Scan Driver


# Si es True, cuando el principal no esté disponible se probará el secundario, false por defecto para evitar problemas si el secundario no es compatible o no se quiere usar
SCANNER_AUTO_FALLBACK=False

# -----------------------------------------------------------------------------
# TESSERACT OCR (para auto-rotación de páginas)
# -----------------------------------------------------------------------------

# Ruta al ejecutable de Tesseract
# Windows: C:\Program Files\Tesseract-OCR\tesseract.exe
# busca en program Files o en program Files (x86) dependiendo de tu sistema y versión de Tesseract
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# -----------------------------------------------------------------------------
# TIMEOUTS (segundos)
# -----------------------------------------------------------------------------

# Timeout para alimentador automático (ADF)
FEEDER_TIMEOUT=7

# Timeout para conexión al cristal (flatbed) - Fase 1
FLATBED_CONNECTION_TIMEOUT=12

# Timeout para escaneo en cristal - Fase 2, puedes cambiar dependiendo de la demora que tenga tu el escaner en terminar
FLATBED_SCAN_TIMEOUT=35

# -----------------------------------------------------------------------------
# LIMPIEZA AUTOMÁTICA
# -----------------------------------------------------------------------------

# Hora/minuto de ejecución diaria del scheduler de limpieza
CLEANUP_SCHEDULE_HOUR=15
CLEANUP_SCHEDULE_MINUTE=30

# Tiempo para considerar expirada/inactiva una sesión y poder limpiarla
CLEANUP_SESSION_TIMEOUT_MINUTES=20

# -----------------------------------------------------------------------------
# IMAGENES (formato y compresion)
# -----------------------------------------------------------------------------

# Formato de salida (webp o png)
SCAN_IMAGE_FORMAT=webp

# Calidad para WEBP (1-100)
SCAN_IMAGE_QUALITY=85

# Metodo de compresion WEBP (0-6, mayor = mas compresion)
SCAN_IMAGE_METHOD=4

# WEBP sin perdida (puede aumentar el peso)
# si esta en True, se ignorarán los valores de calidad y método, ya que no aplican a imágenes sin pérdida, si es False se aplicarán los valores de calidad y método para generar un WEBP con pérdida. Ten en cuenta que usar WEBP sin pérdida puede resultar en archivos más grandes, especialmente para imágenes con mucho detalle o ruido, aunque conservará la máxima calidad posible. En cambio, usar WEBP con pérdida puede reducir significativamente el tamaño del archivo a costa de una posible degradación de la calidad visual, dependiendo de los valores de calidad y método que elijas.
SCAN_IMAGE_LOSSLESS=True

# -----------------------------------------------------------------------------
# LOGGING
# -----------------------------------------------------------------------------

# Nivel de logging: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
